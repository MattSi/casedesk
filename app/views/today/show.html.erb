<% content_for :title, "Today" %>

<h1 class="text-3xl font-semibold"><%= greeting(@now) %>, <%= Current.user.name.split.first %></h1>
<p class="mt-1 text-slate-400"><%= @now.strftime("%A, %B %-d") %></p>

<section class="mt-8">
  <h2 class="text-lg font-semibold">Top priority</h2>

  <div id="top_priority" class="mt-4">
    <% if @overdue_tasks.any? %>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        <%= render partial: "today/task_card", collection: @overdue_tasks, as: :task, locals: { now: @now } %>
      </div>
    <% else %>
      <%= render "today/nothing_overdue" %>
    <% end %>
  </div>
</section>