<% content_for :title, "Today" %>

<h1 class="text-3xl font-semibold"><%= greeting(@now) %>, <%= Current.user.name.split.first %></h1>
<p class="mt-1 text-slate-400"><%= @now.strftime("%A, %B %-d") %></p>

<section class="mt-8">
  <h2 class="text-lg font-semibold">Top priority</h2>

  <div id="top_priority" class="mt-4">
    <% if @overdue_tasks.any? %>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        <%= render partial: "today/task_card", collection: @overdue_tasks, as: :task, locals: { now: @now } %>
      </div>
    <% else %>
      <%= render "today/nothing_overdue" %>
    <% end %>
  </div>
</section>


<section id="upcoming" class="mt-10">
  <h2 class="text-lg font-semibold">Upcoming</h2>

  <% if @upcoming_days.any? %>
    <% @upcoming_days.each do |date, tasks| %>
      <h3 class="mt-6 text-sm font-medium text-slate-400"><%= day_label(date, @now.to_date) %></h3>
      <ul class="mt-2 divide-y divide-slate-800 rounded-xl border border-slate-800 bg-slate-900 px-5">
        <%= render partial: "today/upcoming_task", collection: tasks, as: :task, locals: { now: @now } %>
      </ul>
    <% end %>
  <% else %>
    <p class="mt-4 text-slate-400">Nothing due in the next 7 days.</p>
  <% end %>
</section>