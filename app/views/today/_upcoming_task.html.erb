<li id="<%= dom_id(task) %>" class="flex items-center justify-between gap-4 py-3">
  <div class="min-w-0">
    <p class="truncate font-medium"><%= task.title %></p>
    <p class="text-sm text-slate-400">
      <%= task.due_at.in_time_zone(now.time_zone).strftime("%-l:%M %p") %> · <%= task.matter.display_name %>
    </p>
  </div>
  <%= button_to "Mark complete", task_completion_path(task),
        class: "shrink-0 rounded-md px-3 py-1.5 text-sm bg-slate-800 hover:bg-slate-700 disabled:opacity-50",
        data: { turbo_submits_with: "Completing..." } %>
</li>